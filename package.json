{
  "name": "inspector",
  "version": "1.0.0",
  "main": "src/index.js",
  "scripts": {
    "start": "env NODE_ENV=development node server.js",
    "start:ext": "run-s build:webpack start:both",
    "start:both": "run-p start:firefox start:webpack",
    "start:firefox": "web-ext run --firefox=$npm_package_config_firefox",
    "start:webpack": "yarn build:webpack -- --watch",
    "build:webpack": "webpack",
    "build:ext": "web-ext build -i README.md package.json *.rdf docs",
    "lint": "eslint src test",
    "test": "npm run lint && npm run test:unit",
    "test:unit": "node test | faucet"
  },
  "config": {
    "firefox": "nightly"
  },
  "babel": {
    "presets": [
      "react",
      [
        "env",
        {
          "targets": {
            "node": "current",
            "browsers": "defaults"
          }
        }
      ],
      "flow"
    ],
    "plugins": [
      [
        "transform-runtime",
        {
          "polyfill": false,
          "regenerator": true
        }
      ]
    ]
  },
  "devDependencies": {
    "babel-cli": "^6.26.0",
    "babel-core": "^6.26.0",
    "babel-eslint": "^7.2.1",
    "babel-jest": "^20.0.3",
    "babel-loader": "^7.1.2",
    "babel-plugin-transform-runtime": "^6.23.0",
    "babel-polyfill": "^6.26.0",
    "babel-preset-env": "^1.6.0",
    "babel-preset-flow": "^6.23.0",
    "babel-preset-react": "^6.23.0",
    "babel-preset-react-hmre": "^1.1.1",
    "babelify": "^7.3.0",
    "co": "4.6.0",
    "eslint": "^4.7.2",
    "eslint-config-prettier": "^2.6.0",
    "eslint-plugin-babel": "3.3.0",
    "eslint-plugin-flowtype": "^2.36.0",
    "eslint-plugin-import": "^2.7.0",
    "eslint-plugin-mozilla": "0.0.3",
    "eslint-plugin-prettier": "^2.3.1",
    "eslint-plugin-react": "6.2.2",
    "faucet": "0.0.1",
    "html-webpack-plugin": "^2.30.1",
    "immutable": "3.8.1",
    "mocha": "3.0.2",
    "prettier": "^1.7.0",
    "react": "15.3.1",
    "react-addons-css-transition-group": "15.3.1",
    "react-addons-transition-group": "15.3.1",
    "react-dom": "15.3.1",
    "react-redux": "4.4.5",
    "redux": "3.5.2",
    "redux-logger": "2.6.1",
    "redux-thunk": "2.1.0",
    "tap-dev-tool": "1.3.0",
    "tape": "4.6.0",
    "webpack": "^3.6.0",
    "webpack-dev-server": "^2.8.2"
  },
  "dependencies": {
    "jest": "^21.1.0",
    "npm-run-all": "^4.1.1",
    "uuid": "^3.1.0",
    "web-ext": "^2.0.0"
  },
  "jest": {
    "collectCoverageFrom": [
      "src/**/*.{js,jsx}",
      "!**/node_modules/**"
    ],
    "testEnvironment": "jsdom",
    "moduleFileExtensions": [
      "js",
      "jsx"
    ],
    "moduleDirectories": [
      "node_modules"
    ],
    "moduleNameMapper": {
      "\\.(jpg|jpeg|png|gif|eot|otf|webp|svg|ttf|woff|woff2|mp4|webm|wav|mp3|m4a|aac|oga)$": "<rootDir>/src/test/fixtures/mocks/file-mock.js",
      "\\.(css|less)$": "<rootDir>/src/test/fixtures/mocks/style-mock.js"
    },
    "verbose": true
  }
}
