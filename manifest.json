{
  "description": "An inspector demo.",
  "manifest_version": 2,
  "name": "inspector-ext",
  "version": "1.0",
  "author": "Greg Tatum",
  "homepage_url": "https://github.com/gregtatum/inspector",
  "icons": {
    "48": "icons/star.png"
  },
  "background": {
    "scripts": ["docs/background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["docs/content.js"]
    }
  ],
  "web_accessible_resources": [
    "docs/panel.js",
    "docs/panel.js.map",
    "docs/content.js.map",
    "docs/background.js.map",
    "docs/style.css",
    "docs/variables.css",
    "docs/splitters.css",
    "docs/common.css"
  ],
  "permissions": [
      "<all_urls>"
  ],
  "devtools_page": "docs/devtools.html"
}
